<section class="shell section-pad" id="the-edit"><div class="section-heading"><div><h2>{{ section.settings.heading | escape }}</h2></div><p>{{ section.settings.description | escape }}</p></div><div class="product-grid">
{% if section.settings.collection != blank %}{% for item in section.settings.collection.products limit: 8 %}{% render 'studio-card', item: item %}{% endfor %}{% else %}{% for block in section.blocks %}<div {{ block.shopify_attributes }}>{% assign selected = block.settings.product %}{% if selected != blank %}{% render 'studio-card', item: selected %}{% else %}<div class="card-image">{% if block.settings.image %}{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.title }}{% elsif block.settings.image_url != blank %}<img src="{{ block.settings.image_url | escape }}" width="700" height="700" loading="lazy" alt="{{ block.settings.title | escape }}">{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}<span class="pill">{{ 'product.coming_soon' | t }}</span></div><div class="card-meta"><p class="eyebrow">{{ block.settings.category | escape }}</p><h3>{{ block.settings.title | escape }}</h3><p class="card-price">{{ block.settings.price | escape }}</p></div>{% endif %}</div>{% endfor %}{% endif %}</div></section>
{% schema %}
{"name":"Studio product edit","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"LESS FUSS. MORE LIVING."},{"type":"text","id":"heading","label":"Heading","default":"Meet your everyday helpers."},{"type":"textarea","id":"description","label":"Description","default":"A considered collection of useful finds, made for the little moments that fill your day."},{"type":"collection","id":"collection","label":"Live collection (replaces preview cards)"}],"blocks":[{"type":"product_preview","name":"Product","settings":[{"type":"product","id":"product","label":"Live product"},{"type":"text","id":"title","label":"Title"},{"type":"text","id":"category","label":"Category"},{"type":"text","id":"price","label":"Price text"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"image_url","label":"Hosted image fallback"}]}],"max_blocks":8,"presets":[{"name":"Studio product edit"}]}
{% endschema %}
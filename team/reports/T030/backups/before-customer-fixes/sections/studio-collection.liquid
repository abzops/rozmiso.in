<section class="shell shop-catalog" data-catalog>
<nav class="breadcrumb" aria-label="{{ 'general.navigation' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a> / {{ 'general.shop' | t }}</nav>
<div class="catalog-heading"><div><p class="eyebrow">{{ 'home.edit_label' | t }}</p><h1>{% if collection.handle == 'all' %}{{ 'product.catalog_title' | t }}{% else %}{{ collection.title | escape }}{% endif %}</h1></div><p>{{ 'product.catalog_description' | t }}</p></div>
{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}
{% paginate collection.products by 24 %}
<div class="collection-toolbar"><p role="status" data-result-count>{{ collection.products_count }} {% if collection.products_count == 1 %}{{ 'product.item' | t }}{% else %}{{ 'product.items' | t }}{% endif %}</p><form method="get">{% for filter in collection.filters %}{% for value in filter.active_values %}<input type="hidden" name="{{ value.param_name | escape }}" value="{{ value.value | escape }}">{% endfor %}{% if filter.type == 'price_range' %}{% if filter.min_value.value %}<input type="hidden" name="{{ filter.min_value.param_name | escape }}" value="{{ filter.min_value.value | divided_by: 100.0 }}">{% endif %}{% if filter.max_value.value %}<input type="hidden" name="{{ filter.max_value.param_name | escape }}" value="{{ filter.max_value.value | divided_by: 100.0 }}">{% endif %}{% endif %}{% endfor %}<label for="SortBy">{{ 'product.sort' | t }}</label><select id="SortBy" name="sort_by" data-auto-sort>{% assign current_sort = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select><noscript><button class="text-link" type="submit">{{ 'general.apply' | t }}</button></noscript></form></div>
{% if collection.all_products_count <= 24 and collection.products_count > 0 %}{% assign product_types = collection.products | map: 'type' | uniq %}<div class="category-filters" role="group" aria-label="{{ 'product.categories' | t }}" hidden data-category-filters><button type="button" class="category-filter" aria-pressed="true" data-filter="all">{{ 'product.all' | t }}</button>{% for product_type in product_types %}{% if product_type != blank %}<button type="button" class="category-filter" aria-pressed="false" data-filter="{{ product_type | handleize }}">{{ product_type | escape }}</button>{% endif %}{% endfor %}</div>{% endif %}
{% if collection.all_products_count <= 24 and collection.products_count > 0 %}<div class="catalog-refinements" hidden data-catalog-refinements><div><label for="MinPrice">{{ 'product.price_min' | t }}</label><input id="MinPrice" type="number" min="0" step="1" inputmode="numeric" placeholder="₹0" data-price-min></div><div><label for="MaxPrice">{{ 'product.price_max' | t }}</label><input id="MaxPrice" type="number" min="0" step="1" inputmode="numeric" placeholder="{{ 'product.any_price' | t }}" data-price-max></div><label class="available-filter"><input type="checkbox" data-only-available> {{ 'product.available_only' | t }}</label><button class="text-link" type="button" data-filter-reset>{{ 'product.clear_filters' | t }}</button></div><p hidden class="filter-empty" role="status" data-filter-empty>{{ 'product.filter_empty' | t }}</p>{% endif %}{% if collection.all_products_count > 24 and collection.filters.size > 0 %}
<form action="{{ collection.url }}" method="get" class="catalog-refinements" data-native-filters>
<input type="hidden" name="sort_by" value="{{ current_sort | escape }}">
{% for filter in collection.filters %}
{% unless settings.prelaunch_mode and filter.param_name == 'filter.v.availability' %}
{% case filter.type %}
{% when 'price_range' %}
<div><label for="NativeMinPrice">{{ 'product.price_min' | t }}</label><input id="NativeMinPrice" type="number" min="0" step="0.01" name="{{ filter.min_value.param_name | escape }}" {% if filter.min_value.value %}value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}></div>
<div><label for="NativeMaxPrice">{{ 'product.price_max' | t }}</label><input id="NativeMaxPrice" type="number" min="0" step="0.01" name="{{ filter.max_value.param_name | escape }}" {% if filter.max_value.value %}value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}></div>
{% when 'list', 'boolean' %}
<details><summary>{{ filter.label | escape }}</summary>{% for value in filter.values %}<label class="available-filter"><input type="checkbox" name="{{ value.param_name | escape }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>{{ value.label | escape }} ({{ value.count }})</label>{% endfor %}</details>
{% endcase %}{% endunless %}{% endfor %}
<button type="submit" class="text-link">{{ 'general.apply' | t }}</button><a class="text-link" href="{{ collection.url }}?sort_by={{ current_sort | url_encode }}">{{ 'product.clear_filters' | t }}</a>
</form>
{% endif %}
<div class="product-grid" data-catalog-grid>{% for item in collection.products %}{% render 'studio-card', item: item %}{% else %}<div class="catalog-empty"><h2>{{ 'product.empty' | t }}</h2><a class="button" href="{{ routes.root_url }}">{{ 'general.home' | t }} →</a></div>{% endfor %}</div>
{% if paginate.pages > 1 %}<nav class="pagination">{{ paginate | default_pagination }}</nav>{% endif %}
{% endpaginate %}</section>
{% schema %}
{"name":"Studio collection","settings":[]}
{% endschema %}

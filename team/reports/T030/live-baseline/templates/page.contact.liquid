<section class="shell narrow section-pad"><p class="eyebrow">{{ 'general.help' | t }}</p><h1>{{ page.title | escape }}</h1><div class="rte">{{ page.content }}</div><p class="enquiry-intro">{{ 'general.enquiry_intro' | t }}</p>{% form 'contact', id: 'ContactForm' %}{% if form.posted_successfully? %}<p role="status">{{ 'general.contact_success' | t }}</p>{% endif %}{{ form.errors | default_errors }}<label for="ContactName">{{ 'general.name' | t }}</label><input id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}"><label for="ContactEmail">{{ 'general.email' | t }}</label><input id="ContactEmail" type="email" name="contact[email]" required autocomplete="email" value="{{ form.email | escape }}"><label for="ContactTopic">{{ 'general.enquiry_topic' | t }}</label><select id="ContactTopic" name="contact[Topic]" data-enquiry-topic><option value="General question">{{ 'general.topic_general' | t }}</option><option value="Product availability">{{ 'general.topic_availability' | t }}</option><option value="Product help">{{ 'general.topic_product' | t }}</option><option value="Existing order">{{ 'general.topic_order' | t }}</option><option value="Returns question">{{ 'general.topic_return' | t }}</option></select><label for="ContactProduct">{{ 'general.enquiry_product' | t }}</label><select id="ContactProduct" name="contact[Product]" data-enquiry-product><option value="No specific product">{{ 'general.enquiry_any' | t }}</option>{% for enquiry_product in collections.all.products limit: 50 %}<option value="{{ enquiry_product.title | escape }}">{{ enquiry_product.title | escape }}</option>{% endfor %}</select><label for="ContactMessage">{{ 'general.message' | t }}</label><textarea id="ContactMessage" name="contact[body]" rows="6" required>{{ form.body | escape }}</textarea><p class="small muted enquiry-use">{{ 'general.enquiry_use' | t }}</p><button class="button" type="submit">{{ 'general.send' | t }}</button>{% endform %}</section>
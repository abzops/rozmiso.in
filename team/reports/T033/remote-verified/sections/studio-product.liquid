{% liquid
  assign chosen = product.selected_or_first_available_variant
  assign can_order = chosen.available
  if settings.prelaunch_mode
    assign can_order = false
  endif
  assign is_soap = false
  if product.handle == '2-in-1-soap-dispensing-cleaning-brush'
    assign is_soap = true
  endif
  assign main_image = chosen.featured_image | default: product.featured_image
  assign main_alt = main_image.alt | default: product.title
  assign soap_assets = 'bento-soap-use.webp|bento-soap-studio.webp|bento-soap-rinse.webp|bento-soap-rear.webp|bento-soap-cap.webp|bento-soap-context.webp' | split: '|'
  assign soap_alts = 'Soap brush used face-up with its rear bristles against a sink|Pink soap brush with its top fill cap and rear bristles|Rinsing the grey bristles of the soap brush|Side view showing the rear bristle bed|Top fill cap between the ears of the soap brush|Soap brush resting after use' | split: '|'
%}
<section class="bento-product shell" aria-labelledby="ProductTitle">
  <nav class="breadcrumb" aria-label="{{ 'general.navigation' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a> / <a href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }}</a> / {{ product.title | escape }}</nav>
  <div class="bento-grid" data-product>
    <div class="bento-gallery gallery">
      <div class="bento-main-photo main-photo" data-zoom-image tabindex="0" role="button" aria-label="{{ 'product.zoom' | t }}">
        {% if is_soap %}<img id="ProductImage" src="{{ 'bento-soap-use.webp' | asset_url }}" alt="{{ soap_alts[0] | escape }}" width="1200" height="1200" loading="eager" fetchpriority="high">
        {% elsif main_image %}{{ main_image | image_url: width: 1200 | image_tag: id: 'ProductImage', loading: 'eager', widths: '500, 800, 1200', sizes: '(min-width: 900px) 54vw, 100vw', alt: main_alt }}
        {% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
      </div>
      <div class="bento-thumbs thumbs" aria-label="Product images">
        {% if is_soap %}{% for asset in soap_assets %}<button type="button" data-image="{{ asset | asset_url }}" data-image-id="soap-{{ forloop.index }}" data-alt="{{ soap_alts[forloop.index0] | escape }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ 'product.image' | t }} {{ forloop.index }}"><img src="{{ asset | asset_url }}" alt="{{ soap_alts[forloop.index0] | escape }}" width="160" height="160" loading="lazy"></button>{% endfor %}
        {% else %}{% for image in product.images %}<button type="button" data-image="{{ image | image_url: width: 1200 }}" data-image-id="{{ image.id }}" data-alt="{{ image.alt | default: product.title | escape }}" aria-pressed="{% if image.id == main_image.id %}true{% else %}false{% endif %}" aria-label="{{ 'product.image' | t }} {{ forloop.index }}">{{ image | image_url: width: 180 | image_tag: loading: 'lazy', alt: image.alt }}</button>{% endfor %}{% endif %}
      </div>
      {% render 'studio-product-videos', item: product %}
    </div>
    <div class="bento-summary product-info">
      <p class="eyebrow">{{ product.type | escape }}</p><h1 id="ProductTitle">{{ product.title | escape }}</h1>
      <div class="pdp-price" aria-live="polite"><span data-price>{{ chosen.price | money }}</span><s data-compare {% unless chosen.compare_at_price > chosen.price %}hidden{% endunless %}>{{ chosen.compare_at_price | money }}</s></div>
      <p class="bento-tax muted small">{% if cart.taxes_included %}{{ 'product.tax_included' | t }} {% endif %}{{ 'product.shipping_note' | t }}</p>
      {% if is_soap %}<p class="bento-intro">A compact brush for everyday sink and surface cleaning.</p>{% elsif product.handle == 'usb-rechargeable-fabric-shaver' %}<p class="bento-intro">{{ 'product.shaver_intro' | t }}</p>{% endif %}
      <p class="availability-note" data-availability-note role="status" {% if can_order %}hidden{% endif %}>{{ 'product.launch_note' | t }}</p>
      {% form 'product', product, id: 'ProductForm' %}
        {{ form.errors | default_errors }}
        {% if product.has_only_default_variant %}<input type="hidden" name="id" value="{{ chosen.id }}">
        {% else %}<label for="Variant">{{ 'product.option' | t }}</label><select id="Variant" name="id" data-variants>{% for variant in product.variants %}{% assign variant_image = variant.featured_image | default: product.featured_image %}<option value="{{ variant.id }}" {% if variant.id == chosen.id %}selected{% endif %} data-available="{{ variant.available }}" data-price="{{ variant.price | money | escape }}" data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}" data-min="{{ variant.quantity_rule.min | default: 1 }}" data-step="{{ variant.quantity_rule.increment | default: 1 }}" data-max="{{ variant.quantity_rule.max }}" data-image-id="{% if is_soap %}soap-1{% else %}{{ variant_image.id }}{% endif %}" data-alt="{% if is_soap %}{{ soap_alts[0] | escape }}{% else %}{{ variant_image.alt | default: product.title | escape }}{% endif %}" data-image="{% if is_soap %}{{ 'bento-soap-use.webp' | asset_url }}{% elsif variant_image %}{{ variant_image | image_url: width: 1200 }}{% endif %}">{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — {{ 'product.sold_out' | t }}{% endunless %}</option>{% endfor %}</select>{% endif %}
        <label for="Quantity">{{ 'product.quantity' | t }}</label><div class="bento-quantity" data-bento-quantity><button type="button" data-quantity-minus aria-label="Decrease quantity">−</button><input id="Quantity" type="number" min="{{ chosen.quantity_rule.min | default: 1 }}" step="{{ chosen.quantity_rule.increment | default: 1 }}" {% if chosen.quantity_rule.max %}max="{{ chosen.quantity_rule.max }}"{% endif %} name="quantity" value="{{ chosen.quantity_rule.min | default: 1 }}"><button type="button" data-quantity-plus aria-label="Increase quantity">+</button></div>
        <button class="button wide bento-add" type="submit" data-add data-label="{{ 'product.add' | t }}" data-sold="{{ 'product.sold_out' | t }}" {% unless can_order %}disabled{% endunless %}>{% if can_order %}{{ 'product.add' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</button>
      {% endform %}
      <a data-product-enquiry {% if can_order %}hidden{% endif %} class="button secondary wide product-enquiry" href="{{ routes.root_url }}pages/contact?product={{ product.title | url_encode }}#ContactForm">{{ 'product.availability_contact' | t }} →</a>
      <div class="bento-card bento-facts">
        <div class="bento-fact">{% render 'bento-icon', name: 'sparkle' %}<div><h2>Details</h2>{% if is_soap %}<p>A handheld brush with a refillable liquid holder and a rear bristle bed.</p>{% else %}<div class="product-description rte">{{ product.description }}</div>{% endif %}</div></div>
        {% if is_soap %}<div class="bento-fact">{% render 'bento-icon', name: 'package' %}<div><h2>What's included</h2><p>One brush. Cleaning liquid and styling props are not included.</p></div></div><div class="bento-fact">{% render 'bento-icon', name: 'shield' %}<div><h2>Care</h2><p>Test a discreet area before use. Avoid delicate surfaces. Rinse the bristles after use and allow to air dry.</p></div></div>{% endif %}
      </div>
    </div>
    <div class="bento-card bento-howto">
      {% if is_soap %}<h2>How to use</h2><div class="bento-steps">
        <div><h3><span>1</span>Clean gently</h3><img src="{{ 'bento-soap-use.webp' | asset_url }}" alt="{{ soap_alts[0] | escape }}" width="400" height="320" loading="lazy"><p>Test a discreet area first. Avoid delicate surfaces.</p></div>
        <div><h3><span>2</span>Rinse bristles</h3><img src="{{ 'bento-soap-rinse.webp' | asset_url }}" alt="{{ soap_alts[2] | escape }}" width="400" height="320" loading="lazy"><p>Rinse the bristles after use.</p></div>
        <div><h3><span>3</span>Allow to dry</h3><img src="{{ 'bento-soap-context.webp' | asset_url }}" alt="{{ soap_alts[5] | escape }}" width="400" height="320" loading="lazy"><p>Let the brush air dry before putting it away.</p></div>
      </div>
      {% elsif product.handle == 'usb-rechargeable-fabric-shaver' %}<h2>{{ 'product.shaver_use_title' | t }}</h2><div class="bento-steps bento-steps-text">{% for n in (1..3) %}{% capture step_title %}product.shaver_step{{ n }}_title{% endcapture %}{% capture step_body %}product.shaver_step{{ n }}{% endcapture %}<div><h3><span>{{ n }}</span>{{ step_title | t }}</h3><p>{{ step_body | t }}</p></div>{% endfor %}</div>
      {% else %}<h2>Choose what fits your everyday.</h2><div class="bento-steps bento-steps-text"><div><h3><span>1</span>Read the details</h3><p>Check the product description and what the listing includes.</p></div><div><h3><span>2</span>Choose your option</h3><p>Review the available options and selected price before ordering.</p></div><div><h3><span>3</span>Care thoughtfully</h3><p>Follow the product's care guidance. Ask us if you need a detail clarified.</p></div></div>{% endif %}
    </div>
    <div class="bento-support">
      <div class="bento-card bento-policies"><details><summary>{% render 'bento-icon', name: 'truck' %}<span>{{ 'product.delivery' | t }}</span><span class="bento-chevron" aria-hidden="true">⌄</span></summary><div><p>{{ 'product.delivery_note' | t }}</p>{% if shop.shipping_policy.body != blank %}<a class="text-link" href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a>{% endif %}</div></details><details><summary>{% render 'bento-icon', name: 'returns' %}<span>{{ 'product.returns' | t }}</span><span class="bento-chevron" aria-hidden="true">⌄</span></summary><div>{% if shop.refund_policy.body != blank %}<a class="text-link" href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a>{% else %}<p>{{ 'product.contact_note' | t }}</p><a class="text-link" href="{{ routes.root_url }}pages/contact">{{ 'general.contact' | t }}</a>{% endif %}</div></details></div>
      <a class="bento-card bento-contact" href="{{ routes.root_url }}pages/contact?product={{ product.title | url_encode }}#ContactForm">{% render 'bento-icon', name: 'chat' %}<span>Questions?<br>Get in touch</span>{% render 'studio-icon', name: 'arrow-right' %}</a>
    </div>
  </div>
  {% if product.handle == 'usb-rechargeable-fabric-shaver' %}<div class="product-questions bento-card"><h2>{{ 'product.shaver_faq' | t }}</h2>{% for n in (1..4) %}{% capture question %}product.shaver_q{{ n }}{% endcapture %}{% capture answer %}product.shaver_a{{ n }}{% endcapture %}<details><summary>{{ question | t }}<span aria-hidden="true">+</span></summary><p>{{ answer | t }}</p></details>{% endfor %}</div>{% endif %}
</section>
<section class="shell bento-related related-products"><div class="section-heading"><div><p class="eyebrow">{{ 'home.edit_label' | t }}</p><h2>{{ 'product.explore_more' | t }}</h2></div><a class="text-link" href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }} →</a></div><div class="product-grid">{% assign shown = 0 %}{% for suggestion in collections.all.products %}{% if suggestion.id != product.id and shown < 3 %}{% render 'studio-card', item: suggestion %}{% assign shown = shown | plus: 1 %}{% endif %}{% endfor %}</div></section>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{"name":"Modern Bento product","settings":[]}
{% endschema %}

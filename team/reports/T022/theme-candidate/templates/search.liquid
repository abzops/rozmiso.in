<section class="shell shop-catalog"><p class="eyebrow">{{ 'general.explore' | t }}</p><h1>{{ 'general.search' | t }}</h1><form class="search-form" action="{{ routes.search_url }}" method="get" role="search"><label class="sr-only" for="Search">{{ 'general.search' | t }}</label><input id="Search" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}"><input type="hidden" name="type" value="product"><button class="button" type="submit">{{ 'general.search' | t }}</button></form>{% if search.performed %}{% assign words = search.terms | downcase | split: ' ' %}{% assign match_count = 0 %}{% capture result_cards %}{% for item in collections.all.products limit: 50 %}{% assign searchable = item.title | append: ' ' | append: item.type | append: ' ' | append: item.description | strip_html | downcase %}{% assign matches = true %}{% for word in words %}{% unless searchable contains word %}{% assign matches = false %}{% endunless %}{% endfor %}{% if matches %}{% render 'studio-card', item: item %}{% assign match_count = match_count | plus: 1 %}{% endif %}{% endfor %}{% endcapture %}<p class="search-result-count" role="status">{{ match_count }} {% if match_count == 1 %}{{ 'product.item' | t }}{% else %}{{ 'product.items' | t }}{% endif %}</p><div class="product-grid">{% if match_count > 0 %}{{ result_cards }}{% else %}<div class="catalog-empty"><p>{{ 'product.no_results' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }} →</a></div>{% endif %}</div>{% endif %}</section>

<!doctype html>
<html lang="{{ request.locale.iso_code }}"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">

<meta name="theme-color" content="#26342e">
{% if settings.favicon != blank %}<link rel="icon" type="image/png" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}"><link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">{% else %}<link rel="icon" type="image/png" sizes="32x32" href="data:image/png;base64,"><link rel="icon" type="image/svg+xml" sizes="any" href="{{ 'rozmiso-mark.svg' | asset_url }}"><link rel="apple-touch-icon" sizes="180x180" href="data:image/png;base64,">{% endif %}
<title>{{ page_title | escape }}{% unless page_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}</title>
<meta name="description" content="{{ page_description | default: settings.brand_description | escape }}"><link rel="canonical" href="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | escape }}"><meta property="og:description" content="{{ page_description | default: settings.brand_description | escape }}"><meta property="og:url" content="{{ canonical_url }}"><meta property="og:site_name" content="{{ shop.name | escape }}"><meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
{% if page_image %}<meta property="og:image" content="{{ page_image | image_url: width: 1200 | prepend: 'https:' }}">{% endif %}
{{ content_for_header }}{{ 'studio.css' | asset_url | stylesheet_tag }}<script src="{{ 'studio.js' | asset_url }}" defer></script>
<script>window.rozmisoLabels={searchAll:{{ 'general.search_all' | t | json }},searchMatches:{{ 'general.search_matches' | t | json }},searchFailure:{{ 'general.search_failure' | t | json }},product:{{ 'product.item' | t | json }},products:{{ 'product.items' | t | json }},cartError:{{ 'cart.update_failed' | t | json }},adding:{{ 'cart.adding' | t | json }}};</script></head><body><a class="skip" href="#MainContent">{{ 'general.skip' | t }}</a>{% section 'studio-header' %}<template data-search-catalog>{% for search_product in collections.all.products limit: 50 %}<a href="{{ search_product.url }}" data-id="{{ search_product.id }}" data-title="{{ search_product.title | escape }}" data-price="{{ search_product.price }}" data-available="{{ search_product.available }}" data-image="{% if search_product.featured_image %}{{ search_product.featured_image | image_url: width: 150 }}{% endif %}" data-keywords="{{ search_product.title | escape }} {{ search_product.type | escape }} {{ search_product.description | strip_html | escape }}"></a>{% endfor %}</template><main id="MainContent">{{ content_for_layout }}</main>{% section 'studio-footer' %}<dialog class="image-dialog" data-image-dialog aria-label="{{ 'product.zoom' | t }}"><button type="button" data-close-image aria-label="{{ 'general.close' | t }}">×</button><img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg'/%3E" alt="" width="1200" height="1200" data-zoom-target></dialog></body></html>
<section class="story" id="our-approach"><div class="shell story-grid"><div class="story-brand"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><div class="story-emblem"><svg class="brand-mark" aria-hidden="true" focusable="false" viewBox="0 0 32 32"><rect width="32" height="32" rx="8" fill="#26342e"/><path fill="#fbfaf6" fill-rule="evenodd" d="M9 7h8a7 7 0 0 1 0 14h-3v5H9V7Zm5 5v4h3a2 2 0 0 0 0-4h-3Z"/><path fill="#fbfaf6" d="m17 18 8 8h-7l-6-7Z"/></svg></div><p class="story-signature">{{ 'brand.story_signature' | t }}</p></div><div><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.body | escape }}</p><div class="story-values"><div><span>01</span><h3>{{ 'home.useful_title' | t }}</h3><p>{{ 'home.useful_body' | t }}</p></div><div><span>02</span><h3>{{ 'home.simple_title' | t }}</h3><p>{{ 'home.simple_body' | t }}</p></div><div><span>03</span><h3>{{ 'home.details_title' | t }}</h3><p>{{ 'home.details_body' | t }}</p></div></div></div></div></section>
{% schema %}
{"name":"Studio story","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE ROZMISO WAY"},{"type":"text","id":"heading","label":"Heading","default":"A little more ease. A little more you."},{"type":"textarea","id":"body","label":"Body","default":"We believe the most useful things earn their place in your everyday. Rozmiso brings together practical finds for a tidier home, simpler routines and a little less fuss."}],"presets":[{"name":"Studio story"}]}
{% endschema %}
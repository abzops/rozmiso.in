<footer class="footer"><div class="shell"><div class="footer-brand-line"><span>{{ 'brand.footer_intro' | t }}</span><a href="{{ routes.all_products_collection_url }}">{{ 'general.explore' | t }} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></a></div><div class="footer-top"><div><a class="wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}"><svg class="brand-mark" aria-hidden="true" focusable="false" viewBox="0 0 32 32"><rect width="32" height="32" rx="8" fill="#26342e"/><path fill="#fbfaf6" fill-rule="evenodd" d="M9 7h8a7 7 0 0 1 0 14h-3v5H9V7Zm5 5v4h3a2 2 0 0 0 0-4h-3Z"/><path fill="#fbfaf6" d="m17 18 8 8h-7l-6-7Z"/></svg><span class="brand-name">{{ shop.name | escape }}<span class="brand-descriptor">{{ 'brand.descriptor' | t }}</span></span></a><p>{{ settings.brand_description | escape }}</p></div><div><p class="eyebrow">{{ 'general.explore' | t }}</p><a href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }}</a><a href="{{ routes.search_url }}">{{ 'general.search' | t }}</a><a href="{{ routes.root_url }}#our-approach">{{ 'general.about' | t }}</a></div><div><p class="eyebrow">{{ 'general.help' | t }}</p><a href="{{ routes.root_url }}pages/contact">{{ 'general.contact' | t }}</a>{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</div></div><div class="footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span><span>{{ 'home.footer_note' | t }}</span><div class="payment-icons">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div></div></div></footer>
{% schema %}
{"name":"Studio footer","settings":[]}
{% endschema %}
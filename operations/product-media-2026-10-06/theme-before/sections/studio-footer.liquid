<footer class="footer"><div class="shell"><div class="footer-top"><div><a class="wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">{% render 'studio-logo', reversed: true %}</a><p>{{ settings.brand_description | escape }}</p></div><div><p class="eyebrow">{{ 'general.explore' | t }}</p><a href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }}</a><a href="{{ routes.search_url }}">{{ 'general.search' | t }}</a><a href="{{ routes.root_url }}#our-approach">{{ 'general.about' | t }}</a></div><div><p class="eyebrow">{{ 'general.help' | t }}</p><a href="{{ routes.root_url }}pages/contact">{{ 'general.contact' | t }}</a>{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</div></div><div class="footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span><span>{{ 'home.footer_note' | t }}</span><div class="payment-icons">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div></div></div></footer>
{% schema %}
{"name":"Studio footer","settings":[]}
{% endschema %}
<section class="shell narrow section-pad"><p class="eyebrow">{{ 'general.help' | t }}</p><h1>{{ page.title | escape }}</h1><div class="rte">{{ page.content }}</div>{% form 'contact' %}{% if form.posted_successfully? %}<p role="status">{{ 'general.contact_success' | t }}</p>{% endif %}{{ form.errors | default_errors }}<label for="ContactName">{{ 'general.name' | t }}</label><input id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}"><label for="ContactEmail">{{ 'general.email' | t }}</label><input id="ContactEmail" type="email" name="contact[email]" required autocomplete="email" value="{{ form.email | escape }}"><label for="ContactMessage">{{ 'general.message' | t }}</label><textarea id="ContactMessage" name="contact[body]" rows="6" required>{{ form.body | escape }}</textarea><button class="button" type="submit">{{ 'general.send' | t }}</button>{% endform %}</section>
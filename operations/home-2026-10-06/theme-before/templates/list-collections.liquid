<section class="shell section-pad"><h1>{{ 'general.collections' | t }}</h1>{% paginate collections by 24 %}<div class="product-grid">{% for collection in collections %}<a class="collection-tile" href="{{ collection.url }}">{% if collection.image %}{{ collection.image | image_url: width: 600 | image_tag: loading: 'lazy' }}{% endif %}<h2>{{ collection.title | escape }} ↗</h2></a>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}</section>
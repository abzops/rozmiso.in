<section class="shell section-pad"><p class="eyebrow">{{ 'cart.eyebrow' | t }}</p><h1>{{ 'cart.title' | t }}</h1>{% if cart.item_count == 0 %}<div class="empty-state"><p>{{ 'cart.empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }} ↗</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post" class="cart-layout"><div>{% for item in cart.items %}<div class="cart-row">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}{% endif %}<div><h3><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3><p class="small">{{ item.variant.title | escape }}</p><p>{{ item.final_line_price | money }}</p>{% for discount in item.line_level_discount_allocations %}<p class="small">{{ discount.discount_application.title | escape }} −{{ discount.amount | money }}</p>{% endfor %}<label for="quantity-{{ forloop.index }}">{{ 'product.quantity' | t }}</label><input id="quantity-{{ forloop.index }}" name="updates[]" type="number" min="0" value="{{ item.quantity }}"><a class="text-link small" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></div></div>{% endfor %}<button class="button secondary" type="submit" name="update">{{ 'cart.update' | t }}</button></div><aside class="cart-summary"><h2>{{ 'cart.summary' | t }}</h2>{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }} −{{ discount.total_allocated_amount | money }}</p>{% endfor %}<div class="total"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></div><p class="small muted">{{ 'cart.checkout_note' | t }}</p><button class="button wide" type="submit" name="checkout">{{ 'cart.checkout' | t }} ↗</button><a class="text-link" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a></aside></form>{% endif %}</section>
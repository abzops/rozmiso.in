{% assign chosen = product.selected_or_first_available_variant %}
<section class="shell section-pad"><nav class="breadcrumb" aria-label="{{ 'general.navigation' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a> / <a href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }}</a> / {{ product.title | escape }}</nav>
<div class="pdp" data-product><div class="gallery"><div class="main-photo" data-zoom-image tabindex="0" role="button" aria-label="{{ 'product.zoom' | t }}">{% assign main_image = chosen.featured_image | default: product.featured_image %}{% if main_image %}{{ main_image | image_url: width: 1200 | image_tag: id: 'ProductImage', loading: 'eager', widths: '500, 800, 1200', sizes: '(min-width: 900px) 50vw, 100vw', alt: product.title }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</div><div class="thumbs">{% for image in product.images %}<button type="button" data-image="{{ image | image_url: width: 1200 }}" data-alt="{{ image.alt | default: product.title | escape }}" aria-label="{{ 'product.image' | t }} {{ forloop.index }}">{{ image | image_url: width: 150 | image_tag: loading: 'lazy', alt: image.alt }}</button>{% endfor %}</div></div>
<div class="product-info"><p class="eyebrow">{{ product.type | escape }}</p><h1>{{ product.title | escape }}</h1><div class="pdp-price" aria-live="polite"><span data-price>{{ chosen.price | money }}</span><s data-compare {% unless chosen.compare_at_price > chosen.price %}hidden{% endunless %}>{{ chosen.compare_at_price | money }}</s></div><p class="muted small">{% if cart.taxes_included %}{{ 'product.tax_included' | t }} {% endif %}{{ 'product.shipping_note' | t }}</p>
{% form 'product', product, id: 'ProductForm' %}{{ form.errors | default_errors }}{% if product.has_only_default_variant %}<input type="hidden" name="id" value="{{ chosen.id }}">{% else %}<label for="Variant">{{ 'product.option' | t }}</label><select id="Variant" name="id" data-variants>{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant.id == chosen.id %}selected{% endif %} data-available="{{ variant.available }}" data-price="{{ variant.price | money | escape }}" data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}" data-image="{% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1200 }}{% endif %}">{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — {{ 'product.sold_out' | t }}{% endunless %}</option>{% endfor %}</select>{% endif %}<label for="Quantity">{{ 'product.quantity' | t }}</label><input id="Quantity" type="number" min="{{ chosen.quantity_rule.min | default: 1 }}" step="{{ chosen.quantity_rule.increment | default: 1 }}" {% if chosen.quantity_rule.max %}max="{{ chosen.quantity_rule.max }}"{% endif %} name="quantity" value="{{ chosen.quantity_rule.min | default: 1 }}"><button class="button wide" type="submit" data-add data-label="{{ 'product.add' | t }}" data-sold="{{ 'product.sold_out' | t }}" {% unless chosen.available %}disabled{% endunless %}>{% if chosen.available %}{{ 'product.add' | t }}{% else %}{{ 'product.sold_out' | t }}{% endif %}</button>{% endform %}{% unless chosen.available %}<a class="text-link" href="{{ routes.root_url }}pages/contact">{{ 'product.availability_contact' | t }} →</a>{% endunless %}
<div class="product-description rte">{{ product.description }}</div><details><summary>{{ 'product.delivery' | t }} <span>+</span></summary><p>{{ 'product.delivery_note' | t }}</p>{% if shop.shipping_policy.body != blank %}<a class="text-link" href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a>{% endif %}</details><details><summary>{{ 'product.returns' | t }} <span>+</span></summary>{% if shop.refund_policy.body != blank %}<a class="text-link" href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a>{% else %}<p>{{ 'product.contact_note' | t }}</p><a href="mailto:{{ shop.email | escape }}">{{ 'general.contact' | t }}</a>{% endif %}</details></div></div></section><section class="shell section-pad related-products"><div class="section-heading"><div><p class="eyebrow">{{ 'home.edit_label' | t }}</p><h2>{{ 'product.explore_more' | t }}</h2></div><a class="text-link" href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }} →</a></div><div class="product-grid">{% assign shown = 0 %}{% for suggestion in collections.all.products %}{% if suggestion.id != product.id and shown < 3 %}{% render 'studio-card', item: suggestion %}{% assign shown = shown | plus: 1 %}{% endif %}{% endfor %}</div></section><script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{"name":"Studio product","settings":[]}
{% endschema %}
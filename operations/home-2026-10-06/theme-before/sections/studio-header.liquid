<div class="announcement">{{ section.settings.announcement | escape }}</div><header class="header"><div class="shell header-row"><a class="wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">{{ shop.name | escape }}</a><nav class="desktop-nav" aria-label="{{ 'general.navigation' | t }}"><a href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }}</a><a href="{{ collections['home-care'].url }}">{{ 'general.home_care' | t }}</a><a href="{{ collections['kitchen-essentials'].url }}">{{ 'general.kitchen' | t }}</a><a href="{{ collections['travel-essentials'].url }}">{{ 'general.travel' | t }}</a><a href="{{ routes.root_url }}pages/contact">{{ 'general.help' | t }}</a></nav><div class="header-actions"><a class="mobile-search-link" href="{{ routes.search_url }}" aria-label="{{ 'general.search' | t }}">⌕</a><a class="bag-link" href="{{ routes.cart_url }}" data-open-cart>{{ 'cart.bag' | t }} <span data-cart-badge>{{ cart.item_count }}</span></a><details class="mobile-menu"><summary aria-label="{{ 'general.navigation' | t }}">☰</summary><nav><a href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }}</a><a href="{{ collections['home-care'].url }}">{{ 'general.home_care' | t }}</a><a href="{{ collections['kitchen-essentials'].url }}">{{ 'general.kitchen' | t }}</a><a href="{{ collections['travel-essentials'].url }}">{{ 'general.travel' | t }}</a><a href="{{ routes.root_url }}pages/contact">{{ 'general.help' | t }}</a><a href="{{ routes.root_url }}#our-approach">{{ 'general.about' | t }}</a></nav></details></div></div><div class="shell header-search-row"><div class="instant-search" data-instant-search data-no-results="{{ 'product.no_results' | t }}" data-loading="{{ 'general.search_loading' | t }}" data-unavailable="{{ 'product.sold_out' | t }}" data-currency="{{ shop.currency }}"><form action="{{ routes.search_url }}" method="get" role="search"><label class="sr-only" for="HeaderSearch">{{ 'general.search' | t }}</label><input id="HeaderSearch" type="search" name="q" placeholder="{{ 'general.search_short' | t }}" autocomplete="off" aria-expanded="false" aria-controls="HeaderSuggestions" data-search-input><input type="hidden" name="type" value="product"><button type="submit" aria-label="{{ 'general.search' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 6 6"/></svg></button></form><div id="HeaderSuggestions" class="search-suggestions" hidden data-search-results></div><span class="sr-only" role="status" data-search-status></span></div></div></header><dialog class="cart-drawer" aria-labelledby="DrawerTitle" data-cart-dialog><div class="drawer-heading"><h2 id="DrawerTitle">{{ 'cart.title' | t }}</h2><button type="button" aria-label="{{ 'general.close' | t }}" data-close-cart>×</button></div><p class="drawer-error" role="alert" hidden data-cart-error></p><div data-cart-content data-count="{{ cart.item_count }}">{% if cart.item_count == 0 %}<div class="drawer-empty"><p>{{ 'cart.empty' | t }}</p><a class="button wide" href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }} →</a></div>{% else %}{% for item in cart.items %}<div class="drawer-item">{% if item.image %}{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', alt: item.product.title }}{% endif %}<div><h3><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3>{% unless item.variant.title == 'Default Title' %}<p class="small">{{ item.variant.title | escape }}</p>{% endunless %}<p>{{ item.final_line_price | money }}</p>{% for discount in item.line_level_discount_allocations %}<p class="small">{{ discount.discount_application.title | escape }} −{{ discount.amount | money }}</p>{% endfor %}<label for="DrawerQuantity{{ forloop.index }}">{{ 'product.quantity' | t }}</label><input id="DrawerQuantity{{ forloop.index }}" type="number" min="0" step="{{ item.variant.quantity_rule.increment | default: 1 }}" value="{{ item.quantity }}" data-cart-quantity data-key="{{ item.key | escape }}"><a href="{{ item.url_to_remove }}" class="text-link small" data-cart-remove data-key="{{ item.key | escape }}">{{ 'cart.remove' | t }}</a></div></div>{% endfor %}<div class="drawer-total"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></div>{% for discount in cart.cart_level_discount_applications %}<p class="small">{{ discount.title | escape }} −{{ discount.total_allocated_amount | money }}</p>{% endfor %}<p class="small muted">{{ 'cart.checkout_note' | t }}</p><form action="{{ routes.cart_url }}" method="post"><button class="button wide" type="submit" name="checkout">{{ 'cart.checkout' | t }} →</button></form><a class="text-link" href="{{ routes.cart_url }}">{{ 'cart.view' | t }}</a>{% endif %}<div class="drawer-discover"><h3>{{ 'product.explore_more' | t }}</h3>{% assign cart_ids = cart.items | map: 'product_id' %}{% assign shown = 0 %}{% for suggestion in collections.all.products %}{% unless cart_ids contains suggestion.id %}{% if shown < 2 %}<a class="drawer-suggestion" href="{{ suggestion.url }}">{% if suggestion.featured_image %}{{ suggestion.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: suggestion.title }}{% endif %}<span>{{ suggestion.title | escape }}<small>{{ suggestion.price | money }}{% unless suggestion.available %} · {{ 'product.sold_out' | t }}{% endunless %}</small></span></a>{% assign shown = shown | plus: 1 %}{% endif %}{% endunless %}{% endfor %}</div></div></dialog><a class="support-tab" href="{{ routes.root_url }}pages/contact">{{ 'general.need_help' | t }}</a>
{% schema %}
{"name":"Studio header","settings":[{"type":"text","id":"announcement","label":"Announcement","default":"Little upgrades. Everyday possibilities."}]}
{% endschema %}

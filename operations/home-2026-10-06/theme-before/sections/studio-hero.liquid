<section class="hero shell"><div class="hero-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p class="hero-description">{{ section.settings.description | escape }}</p><a class="button" href="#the-edit">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a><div class="hero-note"><span class="little-star" aria-hidden="true">✳</span>{{ section.settings.note | escape }}</div></div>
<div class="hero-art">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1400 | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 900px) 55vw, 100vw', loading: 'eager', fetchpriority: 'high', class: 'hero-photo' }}{% elsif section.settings.image_url != blank %}<img class="hero-photo" src="{{ section.settings.image_url | escape }}" width="1000" height="1000" alt="{{ section.settings.image_alt | escape }}" fetchpriority="high">{% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'hero-photo' }}{% endif %}<div class="art-label"><span>{{ section.settings.image_label | escape }}</span><span aria-hidden="true">↗</span></div><div class="vertical-label">{{ 'home.edit_label' | t }}</div></div></section>
{% schema %}
{"name":"Studio hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE EVERYDAY EDIT"},{"type":"text","id":"heading","label":"Heading","default":"Small finds. Better everyday."},{"type":"textarea","id":"description","label":"Description","default":"Useful little things for the spaces you love. Discover practical essentials for home, daily routines and days away."},{"type":"text","id":"button_label","label":"Button label","default":"Explore the edit"},{"type":"text","id":"note","label":"Note","default":"Considered essentials. Simple choices."},{"type":"image_picker","id":"image","label":"Hero image"},{"type":"url","id":"image_url","label":"Hosted image fallback"},{"type":"text","id":"image_alt","label":"Image description","default":"Everyday home essential"},{"type":"text","id":"image_label","label":"Image caption","default":"A fresh take on the everyday"}],"presets":[{"name":"Studio hero"}]}
{% endschema %}
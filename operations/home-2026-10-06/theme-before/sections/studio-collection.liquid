<section class="shell shop-catalog" data-catalog>
<nav class="breadcrumb" aria-label="{{ 'general.navigation' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a> / {{ 'general.shop' | t }}</nav>
<div class="catalog-heading"><div><p class="eyebrow">{{ 'home.edit_label' | t }}</p><h1>{% if collection.handle == 'all' %}{{ 'product.catalog_title' | t }}{% else %}{{ collection.title | escape }}{% endif %}</h1></div><p>{{ 'product.catalog_description' | t }}</p></div>
{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}
{% paginate collection.products by 24 %}
<div class="collection-toolbar"><p role="status" data-result-count>{{ collection.products_count }} {% if collection.products_count == 1 %}{{ 'product.item' | t }}{% else %}{{ 'product.items' | t }}{% endif %}</p><form method="get"><label for="SortBy">{{ 'product.sort' | t }}</label><select id="SortBy" name="sort_by" data-auto-sort>{% assign current_sort = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select><noscript><button class="text-link" type="submit">{{ 'general.apply' | t }}</button></noscript></form></div>
{% if paginate.pages == 1 and collection.products_count > 0 %}{% assign product_types = collection.products | map: 'type' | uniq %}<div class="category-filters" role="group" aria-label="{{ 'product.categories' | t }}" hidden data-category-filters><button type="button" class="category-filter" aria-pressed="true" data-filter="all">{{ 'product.all' | t }}</button>{% for product_type in product_types %}{% if product_type != blank %}<button type="button" class="category-filter" aria-pressed="false" data-filter="{{ product_type | handleize }}">{{ product_type | escape }}</button>{% endif %}{% endfor %}</div>{% endif %}
{% if paginate.pages == 1 and collection.products_count > 0 %}<div class="catalog-refinements" hidden data-catalog-refinements><div><label for="MinPrice">{{ 'product.price_min' | t }}</label><input id="MinPrice" type="number" min="0" step="1" inputmode="numeric" placeholder="₹0" data-price-min></div><div><label for="MaxPrice">{{ 'product.price_max' | t }}</label><input id="MaxPrice" type="number" min="0" step="1" inputmode="numeric" placeholder="{{ 'product.any_price' | t }}" data-price-max></div><label class="available-filter"><input type="checkbox" data-only-available> {{ 'product.available_only' | t }}</label><button class="text-link" type="button" data-filter-reset>{{ 'product.clear_filters' | t }}</button></div><p hidden class="filter-empty" role="status" data-filter-empty>{{ 'product.filter_empty' | t }}</p>{% endif %}<div class="product-grid" data-catalog-grid>{% for item in collection.products %}{% render 'studio-card', item: item %}{% else %}<div class="catalog-empty"><h2>{{ 'product.empty' | t }}</h2><a class="button" href="{{ routes.root_url }}">{{ 'general.home' | t }} →</a></div>{% endfor %}</div>
{% if paginate.pages > 1 %}<nav class="pagination">{{ paginate | default_pagination }}</nav>{% endif %}
{% endpaginate %}</section>
{% schema %}
{"name":"Studio collection","settings":[]}
{% endschema %}

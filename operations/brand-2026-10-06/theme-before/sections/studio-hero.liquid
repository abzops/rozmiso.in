{% assign featured = all_products['usb-rechargeable-fabric-shaver'] %}
<div class="home-intro"><section class="hero shell"><div class="hero-copy"><p class="eyebrow hero-kicker"><span aria-hidden="true">✳</span> {{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><p class="hero-description">{{ section.settings.description | escape }}</p><div class="hero-ctas"><a class="button" href="{{ routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a><a class="hero-secondary" href="#home-categories">{{ 'home.browse_categories' | t }} <span aria-hidden="true">↓</span></a></div><div class="hero-note"><span class="little-star" aria-hidden="true">✳</span>{{ section.settings.note | escape }}</div></div>
<div class="hero-art">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1100 | image_tag: widths: '400, 700, 1100', sizes: '(min-width: 900px) 45vw, 100vw', loading: 'eager', fetchpriority: 'high', class: 'hero-photo' }}{% elsif featured.featured_image %}{{ featured.featured_image | image_url: width: 1100 | image_tag: widths: '400, 700, 1100', sizes: '(min-width: 900px) 45vw, 100vw', loading: 'eager', fetchpriority: 'high', class: 'hero-photo', alt: featured.title }}{% elsif section.settings.image_url != blank %}<img class="hero-photo" src="{{ section.settings.image_url | escape }}" width="1000" height="1000" alt="{{ section.settings.image_alt | escape }}" fetchpriority="high">{% endif %}<span class="hero-photo-tag">{{ 'home.spotlight' | t }}</span>{% if featured != blank %}<a class="hero-product-label" href="{{ featured.url }}"><span><small>{{ section.settings.image_label | escape }}</small><strong>{{ featured.title | escape }}</strong><span class="spotlight-price">{{ featured.price | money }}{% unless featured.available %} · {{ 'product.sold_out' | t }}{% endunless %}</span></span><span class="round-arrow" aria-hidden="true">↗</span></a>{% endif %}</div></section>
<div class="shell intro-foot"><span>{{ 'home.home_caption' | t }}</span><span>{{ 'home.kitchen_caption' | t }}</span><span>{{ 'home.travel_caption' | t }}</span></div></div>
<section class="shell home-categories" id="home-categories"><div class="section-heading"><div><p class="eyebrow">{{ 'home.category_eyebrow' | t }}</p><h2>{{ 'home.category_heading' | t }}</h2></div><a class="text-link" href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }} ↗</a></div><div class="home-category-grid">
{% assign category_handles = 'home-care,kitchen-essentials,travel-essentials' | split: ',' %}{% for handle in category_handles %}{% assign category = collections[handle] %}{% assign category_product = category.products.first %}{% if category != blank %}<a class="home-category-card category-{{ forloop.index }}" href="{{ category.url }}"><div><span class="eyebrow">0{{ forloop.index }}</span><h3>{{ category.title | escape }}</h3><p>{% case handle %}{% when 'home-care' %}{{ 'home.home_caption' | t }}{% when 'kitchen-essentials' %}{{ 'home.kitchen_caption' | t }}{% when 'travel-essentials' %}{{ 'home.travel_caption' | t }}{% endcase %}</p><span class="category-cta">{{ 'home.explore_category' | t }} <span aria-hidden="true">↗</span></span></div>{% if category_product.featured_image %}{{ category_product.featured_image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '200, 420', sizes: '(min-width: 900px) 15vw, 40vw', alt: category_product.title }}{% endif %}</a>{% endif %}{% endfor %}</div></section>
{% schema %}
{"name":"Studio hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE EVERYDAY EDIT"},{"type":"text","id":"heading","label":"Heading","default":"Small finds. Better everyday."},{"type":"textarea","id":"description","label":"Description","default":"Useful little things for the spaces you love. Discover practical essentials for home, daily routines and days away."},{"type":"text","id":"button_label","label":"Button label","default":"Explore the edit"},{"type":"text","id":"note","label":"Note","default":"Considered essentials. Simple choices."},{"type":"image_picker","id":"image","label":"Hero image"},{"type":"url","id":"image_url","label":"Hosted image fallback"},{"type":"text","id":"image_alt","label":"Image description","default":"Everyday home essential"},{"type":"text","id":"image_label","label":"Image caption","default":"A fresh take on the everyday"}],"presets":[{"name":"Studio hero"}]}
{% endschema %}
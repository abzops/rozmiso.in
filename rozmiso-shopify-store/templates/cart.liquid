<div class="container" style="padding: 30px 16px; max-width: 700px; margin: 0 auto;">
  <h1 style="font-size: 22px; font-weight: 800; margin-bottom: 20px;">Your Shopping Cart</h1>

  {% if cart.item_count > 0 %}
    <form action="/cart" method="post" novalidate>
      <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; margin-bottom: 20px;">
        {% for item in cart.items %}
          <div style="display: flex; gap: 14px; padding: 12px 0; border-bottom: 1px solid #f1f5f9; align-items: center;">
            <div style="width: 70px; height: 70px; flex-shrink: 0; background: #f8fafc; border-radius: 8px; overflow: hidden;">
              <img src="{{ item.image | image_url: width: 140 }}" alt="{{ item.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
            </div>
            <div style="flex-grow: 1;">
              <a href="{{ item.url }}" style="font-size: 14px; font-weight: 700; color: #0f172a;">{{ item.product.title }}</a>
              <div style="font-size: 12px; color: #64748b;">Qty: {{ item.quantity }}</div>
              <div style="font-size: 14px; font-weight: 800; color: #ff3366;">₹{{ item.line_price | divided_by: 100 }}</div>
            </div>
            <a href="/cart/change?line={{ forloop.index }}&quantity=0" style="color: #ef4444; font-size: 12px; text-decoration: underline;">Remove</a>
          </div>
        {% endfor %}

        <div style="padding-top: 16px; display: flex; justify-content: space-between; align-items: baseline;">
          <span style="font-size: 14px; font-weight: 700;">Subtotal</span>
          <span style="font-size: 20px; font-weight: 800; color: #ff3366;">₹{{ cart.total_price | divided_by: 100 }}</span>
        </div>
        <p style="font-size: 11px; color: #059669; font-weight: 700; margin-top: 4px;">⚡ Free Shipping & Cash On Delivery Available</p>
      </div>

      <div style="display: flex; flex-direction: column; gap: 10px;">
        <button type="submit" name="checkout" class="btn-primary-cod" style="width: 100%; padding: 14px; font-size: 15px;">
          PROCEED TO CHECKOUT (COD / UPI)
        </button>
        <a href="/" style="text-align: center; font-size: 13px; color: #64748b; font-weight: 600;">← Continue Shopping</a>
      </div>
    </form>
  {% else %}
    <div style="text-align: center; padding: 40px 16px; background: #fff; border-radius: 12px; border: 1px solid #e2e8f0;">
      <p style="font-size: 16px; font-weight: 700; margin-bottom: 12px;">Your cart is currently empty</p>
      <a href="/" class="btn-primary-cod" style="display: inline-block; padding: 10px 24px;">Explore Viral Products</a>
    </div>
  {% endif %}
</div>

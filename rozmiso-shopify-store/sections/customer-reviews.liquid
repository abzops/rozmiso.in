<section class="fk-container" style="margin-top: 20px;">
  <div class="fk-reviews-section">
    <div class="fk-reviews-header">
      <h3 style="font-size: 18px; font-weight: 700; color: #212121;">Ratings & Reviews</h3>
      <div class="fk-rating-pill" style="font-size: 14px; padding: 4px 10px;">
        <span>★ 4.8</span>
      </div>
    </div>

    <!-- Rating Score & Star Bars -->
    <div class="fk-ratings-breakdown">
      <div class="fk-big-score">
        <h2>4.8 <span class="star">★</span></h2>
        <p>25,840 Ratings &<br>3,420 Reviews</p>
      </div>

      <div class="fk-bars-list">
        <div class="fk-bar-row">
          <span>5 ★</span>
          <div class="fk-bar-track">
            <div class="fk-bar-fill" style="width: 78%; background: #388e3c;"></div>
          </div>
          <span>20,150</span>
        </div>
        <div class="fk-bar-row">
          <span>4 ★</span>
          <div class="fk-bar-track">
            <div class="fk-bar-fill" style="width: 16%; background: #388e3c;"></div>
          </div>
          <span>4,130</span>
        </div>
        <div class="fk-bar-row">
          <span>3 ★</span>
          <div class="fk-bar-track">
            <div class="fk-bar-fill" style="width: 4%; background: #ff9f00;"></div>
          </div>
          <span>1,030</span>
        </div>
        <div class="fk-bar-row">
          <span>2 ★</span>
          <div class="fk-bar-track">
            <div class="fk-bar-fill" style="width: 1%; background: #ff9f00;"></div>
          </div>
          <span>260</span>
        </div>
        <div class="fk-bar-row">
          <span>1 ★</span>
          <div class="fk-bar-track">
            <div class="fk-bar-fill" style="width: 1%; background: #d32f2f;"></div>
          </div>
          <span>270</span>
        </div>
      </div>
    </div>

    <!-- Verified Buyer Review Cards -->
    <div class="fk-reviews-list">
      
      <!-- Review 1 -->
      <div class="fk-review-card">
        <div class="fk-review-top">
          <span class="fk-rating-pill">5 ★</span>
          <span class="fk-review-headline">Worth every penny! Excellent suction and blower.</span>
        </div>
        <p class="fk-review-body">
          Got this cordless car vacuum delivered in 3 days in Lucknow. The reverse blower cleaned out all AC vents and seat gaps completely. Battery lasted for 2 thorough car cleanings. Highly recommend!
        </p>
        <div class="fk-review-meta">
          <span>Amitabh S., Lucknow</span>
          <span>&bull;</span>
          <span class="certified">✓ Certified Buyer</span>
          <span>&bull;</span>
          <span>2 days ago</span>
        </div>
      </div>

      <!-- Review 2 -->
      <div class="fk-review-card">
        <div class="fk-review-top">
          <span class="fk-rating-pill">5 ★</span>
          <span class="fk-review-headline">Best foot massager mat! Huge pain relief for my mother.</span>
        </div>
        <p class="fk-review-body">
          Ordered the EMS foot therapy mat via Cash on Delivery. My mother uses mode 4 every evening after kitchen work. Swelling and heel pain reduced significantly within 1 week!
        </p>
        <div class="fk-review-meta">
          <span>Sneha Patel, Ahmedabad</span>
          <span>&bull;</span>
          <span class="certified">✓ Certified Buyer</span>
          <span>&bull;</span>
          <span>4 days ago</span>
        </div>
      </div>

      <!-- Review 3 -->
      <div class="fk-review-card">
        <div class="fk-review-top">
          <span class="fk-rating-pill">5 ★</span>
          <span class="fk-review-headline">Great pocket thermal printer! Zero ink hassle.</span>
        </div>
        <p class="fk-review-body">
          My daughter uses it daily for NEET study notes, diagrams, and formulas. Bluetooth connected in 2 seconds on Android. Extra ₹50 discount on UPI was applied instantly.
        </p>
        <div class="fk-review-meta">
          <span>Vikram R., Pune</span>
          <span>&bull;</span>
          <span class="certified">✓ Certified Buyer</span>
          <span>&bull;</span>
          <span>1 week ago</span>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Reviews",
  "settings": [],
  "presets": [
    {
      "name": "Customer Reviews"
    }
  ]
}
{% endschema %}

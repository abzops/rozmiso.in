<header class="fk-header">
  <div class="fk-container">
    <div class="fk-header-inner">
      <!-- Brand Logo & Assured Tagline -->
      <a href="{{ routes.root_url }}" class="fk-brand" aria-label="Rozmiso Home">
        <span class="fk-brand-logo">{{ section.settings.store_name | default: 'Rozmiso' }}</span>
        <span class="fk-brand-sub">
          Explore <span class="plus-badge">Assured ★</span>
        </span>
      </a>

      <!-- Flipkart Search Bar -->
      <div class="fk-search-wrap">
        <form action="{{ routes.search_url }}" method="get" class="fk-search-form" role="search">
          <input 
            type="search" 
            name="q" 
            class="fk-search-input" 
            placeholder="Search for products, brands and more..." 
            value="{{ search.terms | escape }}"
            autocomplete="off"
            aria-label="Search products"
          >
          <button type="submit" class="fk-search-btn" aria-label="Search">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
            </svg>
          </button>
        </form>
      </div>

      <!-- Header Actions -->
      <div class="fk-header-actions">
        <a href="{{ routes.account_url | default: '/account' }}" class="fk-action-item" aria-label="Account">
          <span>👤</span>
          <span>Account</span>
        </a>

        <a href="#wishlist" class="fk-action-item" aria-label="Wishlist">
          <span>❤️</span>
          <span>Wishlist</span>
        </a>

        <a href="{{ routes.cart_url }}" class="fk-action-item cart-btn" aria-label="Shopping Cart">
          <span>🛒</span>
          <span>Cart</span>
          <span class="fk-cart-count">{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Horizontal Category Sub-Nav Ribbon -->
  <nav class="fk-cat-nav" aria-label="Product Categories">
    <div class="fk-container">
      <div class="fk-cat-list">
        <a href="{{ routes.all_products_collection_url }}" class="fk-cat-item">
          <span class="cat-icon">⚡</span>
          <span>Top Offers</span>
        </a>
        <a href="{{ routes.all_products_collection_url }}" class="fk-cat-item">
          <span class="cat-icon">🚗</span>
          <span>Car Gadgets</span>
        </a>
        <a href="{{ routes.all_products_collection_url }}" class="fk-cat-item">
          <span class="cat-icon">🏠</span>
          <span>Home & Kitchen</span>
        </a>
        <a href="{{ routes.all_products_collection_url }}" class="fk-cat-item">
          <span class="cat-icon">📱</span>
          <span>Smart Electronics</span>
        </a>
        <a href="{{ routes.all_products_collection_url }}" class="fk-cat-item">
          <span class="cat-icon">💆</span>
          <span>Health & Wellness</span>
        </a>
        <a href="{{ routes.all_products_collection_url }}" class="fk-cat-item">
          <span class="cat-icon">🎁</span>
          <span>Trending Gifts</span>
        </a>
      </div>
    </div>
  </nav>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "store_name",
      "label": "Store Name",
      "default": "Rozmiso"
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}

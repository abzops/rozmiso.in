<footer class="fk-footer">
  <div class="fk-container">
    <div class="fk-footer-grid">
      
      <!-- Col 1: About -->
      <div class="fk-footer-col">
        <h4>About Rozmiso</h4>
        <p style="color: #9e9e9e; font-size: 12px; line-height: 1.6;">
          Rozmiso is India's dedicated smart utility lifestyle destination. Bringing innovative, problem-solving gadgets and lifestyle essentials to households across India at honest, accessible prices.
        </p>
      </div>

      <!-- Col 2: Help & Policies -->
      <div class="fk-footer-col">
        <h4>Help & Support</h4>
        <ul>
          <li><a href="{{ routes.search_url }}">Track Your Order</a></li>
          <li><a href="/pages/shipping-policy">Shipping & Delivery Policy</a></li>
          <li><a href="/pages/refund-policy">7-Day Replacement Guarantee</a></li>
          <li><a href="/pages/terms-of-service">Terms of Service</a></li>
        </ul>
      </div>

      <!-- Col 3: Consumer Policy -->
      <div class="fk-footer-col">
        <h4>Consumer Policy</h4>
        <ul>
          <li><a href="/pages/privacy-policy">Privacy & Security</a></li>
          <li><a href="/pages/terms-of-service">Grievance Redressal</a></li>
          <li><a href="/pages/shipping-policy">Cash On Delivery Terms</a></li>
        </ul>
      </div>

      <!-- Col 4: Registered Address & Hubs -->
      <div class="fk-footer-col">
        <h4>Registered Hubs</h4>
        <p style="color: #9e9e9e; font-size: 12px; line-height: 1.8;">
          📍 Warehouses: Surat (GJ) & Gurgaon (HR), India<br>
          💬 WhatsApp Support: +91 98765 43210<br>
          ✉️ Email: care@rozmiso.com<br>
          ⏰ Mon - Sat (9:30 AM - 6:30 PM IST)
        </p>
      </div>

    </div>

    <!-- Bottom Strip -->
    <div class="fk-footer-bottom">
      <div>
        <span>&copy; {{ 'now' | date: '%Y' }} Rozmiso. All rights reserved. India's Smart Utility Store.</span>
      </div>

      <div class="fk-payment-badges">
        <span class="fk-payment-tag">💵 100% COD</span>
        <span class="fk-payment-tag">📱 UPI / QR</span>
        <span class="fk-payment-tag">💳 RuPay</span>
        <span class="fk-payment-tag">💳 Visa / Master</span>
      </div>
    </div>
  </div>
</footer>

